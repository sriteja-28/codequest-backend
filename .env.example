# CodeQuest backend - example environment file.
#
# `scripts/dev.ps1 setup` (or scripts/dev.sh setup) copies this to .env and
# fills SECRET_KEY / JUDGE_INTERNAL_API_KEY with random values. Every variable
# has a development default; [PROD-REQUIRED] ones must be set when
# DJANGO_SETTINGS_MODULE=config.settings.production (it refuses to start otherwise).
#
#   DJANGO_SETTINGS_MODULE=config.settings.development   # default (manage.py / asgi.py)
#   DJANGO_SETTINGS_MODULE=config.settings.production    # [PROD-REQUIRED]

# --- Core -------------------------------------------------------------------
# [PROD-REQUIRED] random string, >= 32 chars.
SECRET_KEY=dev-insecure-key-change-in-production
# Development only. Production forces DEBUG off.
DEBUG=true
# [PROD-REQUIRED] comma-separated host names, e.g. codequest.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Public URLs (what the BROWSER uses) --------------------------------------
# Locally always use "localhost", never 127.0.0.1: cookies belong to one host name.
# Production (same origin behind the reverse proxy): both are https://<your-domain>.
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Sign-in (Google / GitHub OAuth; no public passwords) ---------------------
# A provider button appears when both its client id and secret are set.
# Register these callback URLs with each provider:
#       Google: <FRONTEND_URL>/auth/callback/google
#       GitHub: <FRONTEND_URL>/auth/callback/github
#
# Google console: Authorized redirect URI + OAuth consent screen.
# GitHub: OAuth App -> Authorization callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local multi-user testing only: seeded accounts may sign in with a password on
# the login page. development.py defaults this to true; production forces false.
DEV_PASSWORD_AUTH=true

# --- Database (dev stack: infra/docker-compose.dev.yml) ------------------------
DATABASE_URL=postgresql://codequest:codequest_dev@127.0.0.1:5433/codequest

# --- Redis (Channels layer + cache + cache-backed sessions) --------------------
REDIS_URL=redis://127.0.0.1:6380/0
# Separate server for the cache, if desired (defaults to REDIS_URL).
#REDIS_CACHE_URL=redis://127.0.0.1:6380/1
# development.py only: auto (default) = use Redis when reachable, otherwise fall
# back to in-memory cache / DB sessions / in-memory channel layer (single process).
# true = require Redis. false = never use Redis.
USE_REDIS=auto

# --- RabbitMQ (submission queue) ----------------------------------------------
RABBITMQ_URL=amqp://codequest:codequest_dev@127.0.0.1:5673/
# MUST match JUDGE_QUEUE_NAME in judge/.env.
JUDGE_QUEUE_NAME=code_submissions

# --- CORS / CSRF / WebSockets -------------------------------------------------
# Default to FRONTEND_URL (+ BACKEND_PUBLIC_URL for CSRF). Set only to add origins.
#CORS_ORIGINS=http://localhost:3000
#CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
#WS_ALLOWED_ORIGINS=http://localhost:3000
# Number of trusted reverse proxies in front of the API (for client-IP throttling).
#NUM_PROXIES=1

# --- Judge internal API ---------------------------------------------------------
# Shared secret the judge worker sends on internal calls. MUST equal
# JUDGE_INTERNAL_API_KEY in judge/.env. Production refuses the default value.
JUDGE_INTERNAL_API_KEY=judge-secret-key-change-me
# A submission QUEUED/RUNNING longer than this is reaped to INTERNAL_ERROR.
JUDGE_STALE_SUBMISSION_SECONDS=900
# Ended contests are finalized once their submissions are judged, or at the latest
# this many seconds after the end (defaults to JUDGE_STALE_SUBMISSION_SECONDS).
# CONTEST_FINALIZE_GRACE_SECONDS=900

# --- Limits & quotas -------------------------------------------------------------
# Largest accepted source file (bytes, UTF-8). Must match judge MAX_CODE_BYTES.
MAX_CODE_BYTES=65536
# Circuit breaker for the submission queue.
JUDGE_QUEUE_SOFT_LIMIT=500
JUDGE_QUEUE_HARD_LIMIT=1000
# Authored hints and AI chat, per user per UTC day.
AI_HINTS_FREE_DAILY=5
AI_HINTS_PRO_DAILY=50
AI_CHAT_FREE_DAILY=10
AI_CHAT_PRO_DAILY=200

# --- Rate limits ("<n>/<period>"; run/submit also accept e.g. 3/10s) ------------
THROTTLE_ANON=1000/hour
THROTTLE_USER=5000/hour
# Sign-in starts + callbacks per client IP.
THROTTLE_OAUTH=20/minute
THROTTLE_RUN_FREE=10/minute
THROTTLE_RUN_PRO=30/minute
THROTTLE_SUBMIT_FREE=3/minute
THROTTLE_SUBMIT_PRO=10/minute
THROTTLE_BURST=3/10s

# --- Logging ----------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Production-only hardening (read by config.settings.production) ---------------
#AUTH_COOKIE_SAMESITE=Lax          # Lax | Strict | None (None requires HTTPS)
#USE_X_FORWARDED_PROTO=true
#SECURE_SSL_REDIRECT=false
#SECURE_HSTS_SECONDS=0             # e.g. 31536000 once HTTPS is confirmed
#SECURE_HSTS_INCLUDE_SUBDOMAINS=false
